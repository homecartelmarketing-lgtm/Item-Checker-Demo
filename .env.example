# Alibaba Cloud DashScope API key for Qwen vision
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# --- Optional tuning (defaults shown). Calibrate with eval.py, never by feel ---
# QWEN_MODEL=qwen3.8-flash
# ENABLE_ESCALATION=0      # flash only by default; set 1 AND QWEN_ESCALATION_MODEL to use a second model
# QWEN_ESCALATION_MODEL=
# VALID_CONF=90            # auto-pass needs this confidence (missed bad photos are the expensive error)
# INVALID_CONF=85          # auto-flag needs this confidence
# ATTR_CONF=70             # attribute read-outs below this never trigger hard rules
# ENABLE_SWAP_CHECK=1      # re-ask with images swapped when confidence < SWAP_BELOW
# SWAP_BELOW=95
# CLOSEUP_POLICY=valid_if_consistent   # or: review
# DHASH_MAX_DIST=6         # near-duplicate-of-hero detection
# ENABLE_DINO=1            # needs torch + torchvision
# DINO_LOW=0.35            # DINO cosine below this adds a soft conflict
# FEWSHOT_MAX=2            # image-pair examples from knowledge/few_shots/pairs.json
# API_RETRIES=3
# WORKERS=4                # photos checked in parallel per product

# --- v3.1 experiments: turn on one at a time and compare eval.py numbers ---
# MAX_SIDE=1024            # longest side sent to Qwen; try 1280 / 1536
# ZOOM_CROPS=0             # 1 = also send canopy+cords and arms+tiers crops (more tokens per call)
# ENABLE_FASTSAM=1         # fixture box for ZOOM_CROPS; needs `pip install ultralytics`, else white-background box
# FASTSAM_MODEL=FastSAM-s.pt
