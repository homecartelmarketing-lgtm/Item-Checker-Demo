# Alibaba Cloud DashScope API Key for Qwen Vision
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# --- Optional tuning (defaults shown). Calibrate with eval.py ---
# QWEN_MODEL=qwen3.8-flash
# QWEN_ESCALATION_MODEL=qwen-vl-max      # stronger model for borderline cases
# ENABLE_ESCALATION=1
# VALID_CONF=90                          # min confidence to auto-pass
# INVALID_CONF=85                        # min confidence to auto-flag
# ATTR_CONF=70                           # min attribute confidence for hard rules
# CLOSEUP_POLICY=valid_if_consistent     # or: review
# ENABLE_DHASH=1                         # near-duplicate-of-hero detection
# DHASH_MAX_DIST=6
# EXCLUDE_OWN_FEWSHOTS=1                 # don't show a product its own few-shot answers
# API_RETRIES=3
